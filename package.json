{
  "name": "wikinote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:menu && vite",
    "dev:watch": "concurrently \"npm run watch:menu\" \"vite\"",
    "build": "npm run generate:menu && vite build",
    "preview": "vite preview",
    "generate:menu": "node generateMenuConfig.cjs",
    "watch:menu": "nodemon --watch docs --ext md --exec \"npm run generate:menu\"",
    "zip": "node zip-pack.js",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "markdown-it": "^14.1.1",
    "markdown-it-katex": "^2.0.3",
    "pinyin": "^4.0.0",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "archiver": "^8.0.0",
    "concurrently": "^9.2.1",
    "cross-zip-cli": "^1.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "vite": "^8.0.1"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
